# Автозапуск сервера заявок. Положить в /etc/systemd/system/avito-server.service
[Unit]
Description=avito-server (приём заявок с лендинга)
After=network.target

[Service]
Type=simple
User=avito
WorkingDirectory=/var/www/avito-server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
